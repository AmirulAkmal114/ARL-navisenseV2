# ---------------------------------------------------------------------------
# NaviSense backend environment
#
# Copy this file to backend/.env and fill in real values:
#     Copy-Item backend/.env.example backend/.env
#
# Never commit the real backend/.env file.
# ---------------------------------------------------------------------------

# --- PostgREST / database --------------------------------------------------
# Base URL of the PostgREST instance (no trailing slash needed).
POSTGREST_URL=
# JWT / API key used to authenticate requests to PostgREST.
POSTGREST_JWT=


# --- Data ingestion --------------------------------------------------------
# Required by POST /api/ingest and POST /api/insert_ais_data.
# Data producers send it as:  X-API-Key: <value>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=


# --- Account registration --------------------------------------------------
# Required by POST /api/register, sent as:  X-Admin-Key: <value>
# Leave empty to disable registration (the endpoint returns 503).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=


# --- API docs --------------------------------------------------------------
# HTTP Basic credentials for /docs, /redoc and /openapi.json.
# Leave either value empty to disable the docs (they return 404).
DOCS_USERNAME=
DOCS_PASSWORD=


# --- Demo-request email (SMTP) --------------------------------------------
# Used by POST /api/demo-request.
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated list of recipients for demo requests.
ADMIN_EMAILS=
